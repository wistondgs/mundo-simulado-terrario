.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Regenerable experiment output; retain only source configuration and fixtures.
runs/
traces/
checkpoints/
*.safetensors
*.npz
*.parquet

# Local environment metadata generated by tooling.
.env
.sandbox/
.terrario/

# Frontend toolchain and test artifacts (reinstallable / regenerable).
node_modules/
package-lock.json
test-results/
playwright-report/

# Obsidian's shared vault settings are committed; each user's window state is not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# Runtime state from the screening bench; regenerable, never committed.
.sandbox-*/
